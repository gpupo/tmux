#!/usr/bin/env bash
# =============================================================================
#  list-agents — Seleciona e abre um agente de IA em nova janela tmux
# =============================================================================
#
#  Apresenta um menu (fzf ou select) com os agentes disponíveis e abre
#  o escolhido em uma nova janela tmux.
#
#  DEPENDÊNCIAS: tmux, fzf (opcional — cai para select nativo do bash)
#
#  PARA ADICIONAR UM AGENTE:
#  Inclua o nome do executável na lista `agents` abaixo.
#  O executável precisa estar no PATH.

set -euo pipefail

agents=(
    "claude"
    "codex"
    "gemini"
    "copilot"
    "pi"
)

if command -v fzf >/dev/null 2>&1; then
    selected=$(printf "%s\n" "${agents[@]}" | fzf --prompt="Agent » ")
else
    echo "Agentes disponíveis:"
    select selected in "${agents[@]}"; do
        break
    done
fi

if [[ -n "${selected:-}" ]]; then
    tmux new-window -n "$selected" "$selected"
fi
